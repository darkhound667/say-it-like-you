# Sarvam AI subscription key (required) — voice cloning, speak and translate all need it.
SARVAM_API_KEY=
# Global cap on voice syntheses per day across all visitors (429 daily_cap when hit).
DAILY_CAP=150
# 1 = Sarvam-backed routes return 503 paused (maintenance switch, no restart needed).
PAUSE=0
# Public origin of the deployed site (extra allowed CORS origin), e.g. https://sayit.example.com.
PUBLIC_ORIGIN=
# Voice syntheses allowed per session per hour.
SESSION_SPEAK_LIMIT=30
# Requests allowed per IP per hour (speak + translate + attempt).
IP_SPEAK_LIMIT=60
# Port the Flask server listens on.
PORT=8000
